# Copy this file to .env and fill in ONE provider. Never commit .env.

# --- Option A: Google Gemini (free tier, no billing needed) ---
# Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
# Check AI Studio for the current free models and change these if needed.
LLM_MODEL_FAST=gemini-flash-lite-latest
LLM_MODEL_STRONG=gemini-flash-lite-latest

# --- Option B: OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here
# LLM_MODEL_FAST=gpt-4o-mini
# LLM_MODEL_STRONG=gpt-4o

# --- Option C: any OpenAI-compatible endpoint (e.g. a local Ollama server) ---
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL_FAST=llama3.1
# LLM_MODEL_STRONG=llama3.1

# Optional: resilience to rate limits and overloaded servers
# LLM_MAX_RETRIES=5
# LLM_TIMEOUT_MS=120000

PORT=3001
GROBID_URL=http://localhost:8070
